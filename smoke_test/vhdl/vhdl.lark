source_file: design_item+

?design_item: library_clause
            | use_clause
            | entity_decl
            | architecture_body
            | package_decl
            | configuration_decl
            | raw_stmt

library_clause: LIBRARY name_list ";"
use_clause: USE selected_name ("," selected_name)* ";"
package_decl: PACKAGE identifier IS raw_stmt* END PACKAGE? identifier? ";"
configuration_decl: CONFIGURATION identifier OF identifier IS raw_stmt* END CONFIGURATION? identifier? ";"

entity_decl: ENTITY identifier IS entity_item* END ENTITY? identifier? ";"
entity_item: port_clause | generic_clause | declaration | raw_stmt
port_clause: PORT "(" interface_list ")" ";"
generic_clause: GENERIC "(" interface_list ")" ";"
interface_list: interface_item (";" interface_item)* ";"?
interface_item: identifier_list ":" mode? subtype_indication (":=" expr_tokens)?
identifier_list: identifier ("," identifier)*
mode: IN | OUT | INOUT | BUFFER

architecture_body: ARCHITECTURE identifier OF identifier IS declaration* BEGIN concurrent_stmt* END ARCHITECTURE? identifier? ";"
declaration: signal_decl | constant_decl | type_decl | raw_stmt
signal_decl: SIGNAL identifier_list ":" subtype_indication (":=" expr_tokens)? ";"
constant_decl: CONSTANT identifier ":" subtype_indication (":=" expr_tokens)? ";"
type_decl: TYPE identifier IS expr_tokens ";"

concurrent_stmt: process_stmt | raw_stmt
process_stmt: PROCESS sensitivity_list? IS? declaration* BEGIN raw_stmt* END PROCESS identifier? ";"
sensitivity_list: "(" identifier ("," identifier)* ")"

selected_name: identifier ("." identifier)*
subtype_indication: expr_tokens
expr_tokens: raw_token+
raw_stmt: raw_token+ ";"
?raw_token: IDENTIFIER | NUMBER | BASED_NUMBER | BIT_STRING | ESCAPED_STRING | RAW_TOKEN
identifier: IDENTIFIER
name_list: identifier ("," identifier)*

LIBRARY.3: /(?i:library)\b/
USE.3: /(?i:use)\b/
ENTITY.3: /(?i:entity)\b/
ARCHITECTURE.3: /(?i:architecture)\b/
OF.3: /(?i:of)\b/
IS.3: /(?i:is)\b/
BEGIN.3: /(?i:begin)\b/
END.3: /(?i:end)\b/
PACKAGE.3: /(?i:package)\b/
CONFIGURATION.3: /(?i:configuration)\b/
PORT.3: /(?i:port)\b/
GENERIC.3: /(?i:generic)\b/
SIGNAL.3: /(?i:signal)\b/
CONSTANT.3: /(?i:constant)\b/
TYPE.3: /(?i:type)\b/
PROCESS.3: /(?i:process)\b/
INOUT.3: /(?i:inout)\b/
BUFFER.3: /(?i:buffer)\b/
IN.3: /(?i:in)\b/
OUT.3: /(?i:out)\b/

BIT_STRING: /[boxBOX]"[0-9A-Fa-f_xXzZ]+"/
BASED_NUMBER: /\d+#[0-9A-Fa-f_.]+#/
NUMBER: /[+-]?(\d+(\.\d*)?|\.\d+)([eE][+-]?\d+)?/
IDENTIFIER: /[A-Za-z][A-Za-z0-9_]*/
RAW_TOKEN: /[^\s;]+/

%import common.ESCAPED_STRING
COMMENT: /--[^\n]*/
%ignore COMMENT
%ignore /[ \t\r\n]+/

