selfies: token+
token: BRANCH_TOKEN
     | RING_TOKEN
     | BOND_TOKEN
     | SPECIAL_TOKEN
     | ATOM_TOKEN
     | SELFIES_TOKEN

BRANCH_TOKEN.5: /\[Branch[^\]\s]*\]/
RING_TOKEN.5: /\[Ring[^\]\s]*\]/
BOND_TOKEN.4: /\[(=|#|\/|\\)[^\]\s]*\]/
SPECIAL_TOKEN.4: /\[(epsilon|nop|STOP|Expl|Impl)[^\]\s]*\]/i
ATOM_TOKEN.3: /\[[A-Za-z@+\-=#0-9]+\]/
SELFIES_TOKEN: /\[[^\]\s]+\]/

%ignore /[ \t\r\n]+/

